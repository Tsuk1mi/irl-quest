<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- Разрешить cleartext для локального IP разработки -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">192.168.43.52</domain>
  </domain-config>

  <!-- По умолчанию запретить cleartext для остальных доменов -->
  <base-config cleartextTrafficPermitted="false" />
</network-security-config>
