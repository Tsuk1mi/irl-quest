<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.IrlQuest" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorPrimaryContainer">@color/primaryColorVariant</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorPrimaryInverse">@color/primaryColor</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondaryColor</item>
        <item name="colorSecondaryContainer">@color/secondaryColorVariant</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Background colors -->
        <item name="android:colorBackground">@color/backgroundColor</item>
        <item name="colorSurface">@color/surfaceColor</item>
        <item name="colorOnSurface">@color/onSurfaceColor</item>

        <!-- Error colors -->
        <item name="colorError">@color/errorColor</item>
        <item name="colorOnError">@color/onErrorColor</item>
        <item name="colorErrorContainer">@color/errorContainerColor</item>
        <item name="colorOnErrorContainer">@color/onErrorContainerColor</item>
    </style>
</resources>
