# База данных
DATABASE_URL=postgres://postgres:tsukimi@localhost:5432/irl_quest
POSTGRES_PASSWORD=tsukimi

# Сервер
PORT=8003
PUBLIC_IP=
# Оставьте пустым для автодетекта локального IP

# Безопасность\ Аунтефикация
JWT_SECRET=dev-secret-CHANGE-THIS-IN-PRODUCTION
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=30
PASSWORD_MIN_LENGTH=8

# Блокировка
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Фичи
ENABLE_MFA=false
ENABLE_OAUTH=false
ENABLE_AR=false
ENABLE_MULTIPLAYER=true
ENABLE_IMAGE_PROCESSING=false
IMAGE_RETENTION_MINUTES=5

# AI\ML
ML_BASE_URL=http://localhost:11434
ML_MODEL_PATH=
ML_INFER_CMD=
ML_EMBED_CMD=

# CORS
CORS_ORIGIN=*
# Для production укажите конкретные домены:
# CORS_ORIGIN=https://yourdomain.com,https://app.yourdomain.com

# Logger
RUST_LOG=info,tower_http=debug,sqlx=info
# Уровни: error, warn, info, debug, trace

# Docker
REDIS_PASSWORD=redis_password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
GRAFANA_PASSWORD=admin

# Auth
CLIENT_CONFIG_ENDPOINT=true
